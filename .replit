modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev & pnpm --filter @workspace/streamfetch run build && pnpm --filter @workspace/streamfetch run serve"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["yt-dlp"]

[userenv]

[userenv.shared]
PORT = "5000"
API_PORT = "8080"
VITE_GOOGLE_CLIENT_ID = "27328018611-c7n2q31dii1bee41jhn0jqfcd4skgn3j.apps.googleusercontent.com"
GOOGLE_CLIENT_ID = "27328018611-c7n2q31dii1bee41jhn0jqfcd4skgn3j.apps.googleusercontent.com"
EMAIL_USER = "ytsavetools@gmail.com"

[userenv.development]
NODE_ENV = "development"
ALLOWED_ORIGIN = ""
